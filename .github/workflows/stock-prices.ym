name: Stock prices

on:
  schedule:
    - cron: "30 22 * * 1-5"
  push:
    paths:
      - "stocks/tickers.txt"
  workflow_dispatch:

permissions:
  contents: write

concurrency: stock-prices

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install yfinance
      - run: python stocks/fetch_prices.py
      - name: Commit prices.json
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898699+github-actions[bot]@users.noreply.github.com"
          git add stocks/prices.json
          git diff --cached --quiet && exit 0
          git commit -m "Update stock prices"
          git pull --rebase
          git push
